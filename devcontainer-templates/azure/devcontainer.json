// Azure variant — base + azure-cli.
// devcontainer.json has no inheritance, so the base features are repeated here.
{
	"name": "azure",
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu26.04",

	"features": {
		// --- base ---
		"ghcr.io/devcontainers/features/python:1": {
			"version": "3.12"
		},
		"ghcr.io/devcontainers/features/node:1": {
			"version": "lts"
		},
		"ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
			"version": "latest",
			"helm": "latest",
			"minikube": "none"
		},
		// Neovim current stable — official AppImage, extracted (no FUSE), ~40 MB.
		"ghcr.io/stu-bell/devcontainer-features/neovim:0": {},
		// --- azure ---
		// MS hasn't published its azure-cli apt repo for ubuntu 26.04 yet, so the
		// feature falls back to a pipx install (slower build; heals itself upstream).
		"ghcr.io/devcontainers/features/azure-cli:1": {}
	},

	// Reuse host Azure credentials (run `mkdir -p ~/.azure` on the host once).
	"mounts": [
		"source=${localEnv:HOME}/.azure,target=/home/vscode/.azure,type=bind"
	],

	// Override the neovim feature's baked-in XDG_CONFIG_HOME=/config (see base).
	"containerEnv": {
		"XDG_CONFIG_HOME": "/home/vscode/.config"
	},

	"remoteUser": "vscode"
}
